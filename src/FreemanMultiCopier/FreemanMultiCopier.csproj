<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FreemanMultiCopier</RootNamespace>
    <AssemblyName>FreemanMultiCopier</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <Version>0.1.0</Version>
    <Product>Freeman MULTICOPIER</Product>
    <Company>Freeman</Company>
    <Description>Copiador simultaneo multi-dispositivo</Description>

    <!-- Culture invariante: evita que un separador decimal local rompa los tamanos -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Publicar en un unico .exe autocontenido -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
