<!-- No se usa StartupUri: la ventana se abre a mano desde App.OnStartup para poder
     arrancar en modo prueba sin que aparezca interfaz grafica. -->
<Application x:Class="FreemanMultiCopier.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI\Themes\Dark.xaml" />
                <ResourceDictionary Source="UI\Themes\Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
