<UserControl x:Class="FreemanMultiCopier.UI.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FreemanMultiCopier.UI.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:DeviceIconConverter x:Key="DeviceIcon" />
        <conv:ByteSizeConverter x:Key="Bytes" />
        <conv:PercentConverter x:Key="Percent" />
        <conv:StateBrushConverter x:Key="StateBrush" />
        <conv:StateTextConverter x:Key="StateText" />
    </UserControl.Resources>

    <Grid>
        <!-- Halo rojo que se dibuja DETRAS de la tarjeta cuando esta marcada. Va con
             margen negativo a proposito: así el resplandor no reserva sitio ni empuja
             al resto de tarjetas del panel. -->
        <Border x:Name="Glow"
                Margin="-5"
                CornerRadius="14"
                Background="{DynamicResource SelectGlowBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- El aspecto va TODO dentro del Style, nunca como atributo local: un valor
             local gana a los triggers del Style, y si el color se fijara aqui el marco
             rojo jamas apareceria. Por eso no se repite BorderBrush fuera. -->
        <Border x:Name="Root"
                Padding="12,10"
                Margin="0,0,8,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <!-- El grosor es FIJO, anche sin marcar. Si solo creciera al marcar,
                         la rejilla de tarjetas reflujaria y el panel daría un salto al
                         pasar por quince memorias. Lo que cambia al marcar es el color. -->
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectFillBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- icono, nombre y letra de unidad -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="30" Height="30"
                          Stretch="Uniform"
                          Stroke="{DynamicResource TextDimBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="{Binding Volume.Kind, Converter={StaticResource DeviceIcon}, Mode=OneWay}" />

                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{DynamicResource DimText}"
                                   Text="{Binding Volume.KindLabel, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="5"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Volume.Id, Mode=OneWay}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- barra de progreso -->
                <Grid Grid.Row="1" Margin="0,10,0,4">
                    <ProgressBar Value="{Binding Job.Progress, Mode=OneWay}" Minimum="0" Maximum="1" />
                    <TextBlock Text="{Binding Job.Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               FontSize="10" />
                </Grid>

                <!-- cifras: espacio libre y velocidad -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource DimText}" FontSize="11" Text="Libre " />
                        <!-- Espacio libre EN VIVO: el de la tarjeta descuenta lo que se ha
                             escrito, no el que midio el vigilante al enumerar. -->
                        <TextBlock Style="{DynamicResource DimText}" FontSize="11"
                                   Text="{Binding Job.FreeSpaceLive, Converter={StaticResource Bytes}, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Style="{DynamicResource MonoText}"
                               FontSize="11"
                               Text="{Binding SpeedText, Mode=OneWay}" />
                </Grid>

                <!-- estado y numero de archivos en cola -->
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{Binding Job.State, Converter={StaticResource StateBrush}, Mode=OneWay}"
                               Text="{Binding Job.State, Converter={StaticResource StateText}, Mode=OneWay}" />

                    <TextBlock Grid.Column="1"
                               Style="{DynamicResource DimText}"
                               FontSize="11"
                               Text="{Binding Job.Queue.Count, Mode=OneWay, StringFormat=archivos: {0}}" />
                </Grid>

                <!-- Distintivo de esquina con el visto bueno. Va superpuesto y en
                     posicion absoluta para no mover ni un pixel el resto del contenido
                     al marcar o desmarcar la tarjeta. -->
                <Border Width="20" Height="20"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="-8,-8,0,0"
                        Background="{DynamicResource SelectBrush}"
                        BorderBrush="{DynamicResource CardBrush}"
                        BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Width="11" Height="11"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 0,5.2 L 3.7,8.9 L 10,1.2" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
