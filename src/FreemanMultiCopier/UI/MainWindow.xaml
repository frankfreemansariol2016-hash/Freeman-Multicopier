<Window x:Class="FreemanMultiCopier.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FreemanMultiCopier.UI"
        Title="Freeman MULTICOPIER"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="900"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ByteSizeConverter xmlns:conv="clr-namespace:FreemanMultiCopier.UI.Converters" x:Key="Bytes" />
        <conv:MiddleEllipsisConverter xmlns:conv="clr-namespace:FreemanMultiCopier.UI.Converters" x:Key="MiddleEllipsis" />
        <conv:BoolToVisConverter xmlns:conv="clr-namespace:FreemanMultiCopier.UI.Converters" x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================== barra superior -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Freeman MULTICOPIER" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Margin="10,3,0,0" Style="{DynamicResource DimText}" Text="v0.1" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource DimText}" Margin="0,0,14,0">
                        <Run Text="Dispositivos:" /><Run Text="{Binding TotalDevices, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{DynamicResource DimText}" Margin="0,0,14,0">
                        <Run Text="Seleccionados:" /><Run Text="{Binding SelectedDevices, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{DynamicResource DimText}" Margin="0,0,14,0">
                        <Run Text="Trabajando:" /><Run Text="{Binding WorkingDevices, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{DynamicResource DimText}" Margin="0,0,14,0">
                        <Run Text="RAM:" /><Run Text="{Binding BufferUsed, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding TotalThroughput, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================== cuerpo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!--  panel izquierdo: el buscador y la copia en curso  -->
            <Grid Grid.Column="0" Margin="12,10,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" Margin="0,0,0,8" x:Name="LeftTabs"
                            Background="Transparent" BorderThickness="0"
                            Focusable="False">
                    <TabItem Header="Buscador">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Buscador" Style="{DynamicResource TitleText}" Margin="0,0,0,6" />

                                <!-- Campo de texto y boton de carpeta en dos columnas: el buscador
                                     tiene que decir donde mira, y dejar poder cambiarlo. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Grid.Column="0"
                                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             ToolTip="Escribe el nombre. Se busca en la carpeta de abajo mientras tecleas." />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,0"
                                            Content="..."
                                            Click="OnBrowseSearchRoot">
                                        <Button.ToolTip>
                                            <TextBlock Text="{Binding SearchRootToolTip, Mode=OneWay}" />
                                        </Button.ToolTip>
                                    </Button>
                                </Grid>

                                <TextBlock Style="{DynamicResource DimText}" Margin="0,4,0,0"
                                           Text="{Binding SearchRootLabel, Mode=OneWay}" />
                                <TextBlock Style="{DynamicResource DimText}" Margin="0,2,0,0"
                                           Text="{Binding SearchStatus, Mode=OneWay}" />
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     x:Name="ResultsList"
                                     ItemsSource="{Binding Results, Mode=OneWay}"
                                     Background="{DynamicResource SurfaceAltBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     SelectionMode="Extended"
                                     AllowDrop="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="12"
                                                           Text="{Binding SourcePath, Converter={StaticResource MiddleEllipsis}, ConverterParameter=52, Mode=OneWay}" />
                                                <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                                           Text="{Binding Kind, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{DynamicResource DimText}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Length, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- ============================================ lo que se esta copiando -->
                    <TabItem Header="Copia en curso">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Copia en curso"
                                       Style="{DynamicResource TitleText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Style="{DynamicResource DimText}" Margin="0,0,0,8"
                                       Text="Que se esta leyendo del origen y cuanto queda libre en cada destino." />

                            <!-- Lo que esta saliendo del ORIGEN. Va arriba a proposito: es la
                                 pregunta que se hace primero ("de donde me esta viniendo esto y
                                 a que velocidad"), y la respuesta es la misma para todos los
                                 destinos que comparten el archivo. -->
                            <Border Grid.Row="2" Margin="0,0,0,9" CornerRadius="7" Padding="10,8"
                                    BorderThickness="1"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource SelectBrush}"
                                    Visibility="{Binding Origin.HasWork, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{DynamicResource DimText}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Text="ORIGEN" />
                                        <TextBlock Grid.Column="1" Style="{DynamicResource DimText}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Text="{Binding Origin.SizeText, Mode=OneWay}" />
                                    </Grid>

                                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Origin.FileName, Mode=OneWay}" />

                                    <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Origin.Folder, Mode=OneWay}" />

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SelectBrush}"
                                                   Text="{Binding Origin.ReadText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Origin.TransferText, Mode=OneWay}" />
                                    </Grid>

                                    <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="{Binding Origin.TargetsText, Mode=OneWay}" />

                                    <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{Binding Origin.OthersText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ActivityHost"
                                              ItemsSource="{Binding CopyActivity, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="7"
                                                    Padding="10,8" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding DisplayName, Mode=OneWay}" />
                                                        <TextBlock Grid.Column="1" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding PercentText, Mode=OneWay}" />
                                                    </Grid>

                                                    <!-- archivo que se esta leyendo del origen -->
                                                    <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding CurrentFile, Mode=OneWay}" />

                                                    <ProgressBar Margin="0,6,0,0" Height="7"
                                                                 Value="{Binding Progress, Mode=OneWay}"
                                                                 Minimum="0" Maximum="1" />

                                                    <!-- barra fina: solo el archivo actual -->
                                                    <Grid Margin="0,3,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                                        <ProgressBar Height="3"
                                                                     Value="{Binding ActiveFraction, Mode=OneWay}"
                                                                     Minimum="0" Maximum="1"
                                                                     Foreground="{DynamicResource SelectBrush}" />
                                                    </Grid>

                                                    <WrapPanel Margin="0,5,0,0">
                                                        <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                                                   Margin="0,0,10,0"
                                                                   Text="{Binding StateLabel, Mode=OneWay}" />
                                                        <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                                                   Margin="0,0,10,0"
                                                                   Text="{Binding FilesText, Mode=OneWay}" />
                                                        <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                                                   Margin="0,0,10,0"
                                                                   Text="{Binding ReadText, Mode=OneWay}" />
                                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SelectBrush}"
                                                                   Margin="0,0,10,0"
                                                                   Text="{Binding WriteText, Mode=OneWay}" />
                                                        <TextBlock Style="{DynamicResource DimText}" FontSize="10"
                                                                   Margin="0,0,10,0"
                                                                   Text="{Binding RemainingText, Mode=OneWay}" />
                                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SelectBrush}"
                                                                   Text="{Binding FreeText, Mode=OneWay}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- separador arrastrable -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!--  panel derecho: los dispositivos  -->
            <Grid Grid.Column="2" Margin="6,10,12,10"
                  AllowDrop="True"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Dispositivos" Style="{DynamicResource TitleText}" Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DeviceHost" ItemsSource="{Binding Devices, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:DeviceCard Width="238"
                                              ToggleSelectCommand="{Binding DataContext.ToggleDeviceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================== barra de acciones -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <WrapPanel>
                <Button Style="{StaticResource CycleButton}" Click="OnCycleMode"
                        MouseRightButtonUp="OnCycleModeBack"
                        ToolTip="Modo de copia. Clic derecho vuelve al anterior.">
                    <TextBlock Text="{Binding ModeLabel, Mode=OneWay}" />
                </Button>

                <Button Style="{StaticResource CycleButton}" Click="OnCycleStructure"
                        MouseRightButtonUp="OnCycleStructureBack"
                        ToolTip="Estructura de carpetas para el dispositivo marcado. Clic derecho vuelve a la anterior.">
                    <TextBlock Text="{Binding StructureLabel, Mode=OneWay}" />
                </Button>

                <Button Style="{StaticResource PrimaryButton}" Click="OnStart"
                        ToolTip="Empezar a copiar a los dispositivos seleccionados.">
                    <TextBlock Text="COPIAR" FontWeight="Bold" />
                </Button>

                <Button Style="{StaticResource ToolButton}" Click="OnPauseAll" Content="Pausar todo" />
                <Button Style="{StaticResource ToolButton}" Click="OnResumeAll" Content="Continuar todo" />

                <Separator Margin="6,2" />

                <Button Style="{StaticResource ToolButton}" Click="OnSelectAll" Content="Seleccionar todo" />
                <Button Style="{StaticResource ToolButton}" Click="OnSelectNone" Content="Quitar"
        ToolTip="Desmarca todas las tarjetas de golpe." />

                <Separator Margin="6,2" />

                <Button Style="{StaticResource ToolButton}" Click="OnClone" Content="Clonar lista"
                        ToolTip="Repite en los otros dispositivos la misma cola, sin volver a buscar." />
                <Button Style="{StaticResource ToolButton}" Click="OnClearFinished" Content="Limpiar"
                        ToolTip="Saca de la cola lo ya copiado bien y deja solo lo que falta." />
                <Button Style="{StaticResource ToolButton}" Click="OnRetryErrors" Content="Reintentar"
                        ToolTip="Vuelve a encolar solo los archivos que fallaron." />

                <Separator Margin="6,2" />

                <Button Style="{StaticResource ToolButton}" Click="OnEjectSelected" Content="Expulsar"
                        ToolTip="Expulsa con seguridad, esperando a que termine lo pendiente." />
            </WrapPanel>
        </Border>

        <!-- ================================================== barra de estado -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{DynamicResource DimText}" FontSize="11"
                           Text="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />

                <!-- El intervalo de refresco va aqui porque es la unica cifra que se
                     nota en caliente: a 250 ms la copia en curso se ve a saltos, y a
                     3 ms se ve liquida. Clic derecho vuelve al valor anterior. -->
                <Button Grid.Column="1" Style="{StaticResource ToolButton}"
                        Margin="10,0" Padding="8,1"
                        Click="OnCycleRefresh"
                        MouseRightButtonUp="OnCycleRefreshBack"
                        ToolTip="Cada cuanto se refresca la ventana de copia. Clic derecho vuelve al anterior."
                        Content="{Binding RefreshLabel, Mode=OneWay}" />

                <TextBlock Grid.Column="2" Style="{DynamicResource DimText}" FontSize="11"
                           Text="{Binding SelectionSummary, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
