<!-- Paleta oscura, la de fabrica. Todas las superficies y textos de la aplicacion se
     resuelven a partir de estas claves, asi que cambiar el aspecto entero es sustituir
     este diccionario y ya esta. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- superficies -->
    <Color x:Key="SurfaceColor">#FF1E1F24</Color>
    <Color x:Key="SurfaceAltColor">#FF26282F</Color>
    <Color x:Key="CardColor">#FF2B2E36</Color>
    <Color x:Key="BorderColor">#FF3A3E48</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- texto -->
    <Color x:Key="TextColor">#FFF2F3F5</Color>
    <Color x:Key="TextDimColor">#FF9AA0AC</Color>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <!-- acento -->
    <Color x:Key="AccentColor">#FF3D8BFF</Color>
    <Color x:Key="AccentDarkColor">#FF2C6BD6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />

    <!-- seleccion de destino. El rojo es la senal unica de "esta marcado": marco
         grueso, relleno tenue y halo. Con un disco duro lleno de nombres iguales
         hace falta algo que no se pase por alto de reojo. -->
    <Color x:Key="SelectColor">#FFFF3B30</Color>
    <Color x:Key="SelectFillColor">#FF3A1F24</Color>
    <Color x:Key="SelectGlowColor">#66FF3B30</Color>
    <SolidColorBrush x:Key="SelectBrush" Color="{StaticResource SelectColor}" />
    <SolidColorBrush x:Key="SelectFillBrush" Color="{StaticResource SelectFillColor}" />
    <SolidColorBrush x:Key="SelectGlowBrush" Color="{StaticResource SelectGlowColor}" />

    <!-- semaforo -->
    <Color x:Key="OkColor">#FF3FB950</Color>
    <Color x:Key="WarnColor">#FFD29922</Color>
    <Color x:Key="ErrorColor">#FFE5534B</Color>
    <Color x:Key="IdleColor">#FF6E7681</Color>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

</ResourceDictionary>
